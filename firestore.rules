                         request.resource.data.keys().hasOnly(['coupleId', 'senderUid', 'senderName', 'memberUids', 'songTitle', 'artistName', 'vibeEmoji', 'dedicationNote', 'lovedByPartner', 'createdAt', 'updatedAt']) &&
                         isValidVibeDedication(request.resource.data, coupleId) &&
                         request.resource.data.senderUid == request.auth.uid &&
                         request.resource.data.lovedByPartner == false &&
                         request.auth.uid in request.resource.data.memberUids &&
                         isCoupleMemberDoc(coupleId) &&
                         request.resource.data.memberUids == get(couplePath(coupleId)).data.memberUids;

        allow update: if isSignedIn() &&
                         isValidId(coupleId) &&
                         isValidId(vibeId) &&
                         isValidVibeDedication(request.resource.data, coupleId) &&
                         request.resource.data.coupleId == resource.data.coupleId &&
                         request.resource.data.senderUid == resource.data.senderUid &&
                         request.resource.data.senderName == resource.data.senderName &&
                         request.resource.data.songTitle == resource.data.songTitle &&
                         request.resource.data.artistName == resource.data.artistName &&
                         request.resource.data.vibeEmoji == resource.data.vibeEmoji &&
                         request.resource.data.dedicationNote == resource.data.dedicationNote &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         (
                           (
                             request.auth.uid in resource.data.memberUids &&
                             request.auth.uid != resource.data.senderUid &&
                             request.resource.data.memberUids == resource.data.memberUids &&
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lovedByPartner', 'updatedAt'])
                           ) ||
                           (
                             resource.data.senderUid == request.auth.uid &&
                             isCoupleMemberDoc(coupleId) &&
                             request.resource.data.memberUids == get(couplePath(coupleId)).data.memberUids &&
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
                           )
                         );

        allow delete: if isSignedIn() && isValidId(coupleId) && isValidId(vibeId) && request.auth.uid in resource.data.memberUids;
      }

      // --- 14. CARE & WELLNESS CHECK-INS ---
      match /care_checkins/{checkinId} {
        allow get: if isSignedIn() && isValidId(coupleId) && isValidId(checkinId) && request.auth.uid in resource.data.memberUids;
        allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;

        allow create: if isSignedIn() &&
                         isValidId(coupleId) &&
                         isValidId(checkinId) &&
                         request.resource.data.keys().hasAll(['coupleId', 'senderUid', 'senderName', 'memberUids', 'careType', 'message', 'acknowledged', 'createdAt', 'updatedAt']) &&
                         request.resource.data.keys().hasOnly(['coupleId', 'senderUid', 'senderName', 'memberUids', 'careType', 'message', 'acknowledged', 'acknowledgedByUid', 'createdAt', 'updatedAt']) &&
                         isValidCareCheckIn(request.resource.data, coupleId) &&
                         request.resource.data.senderUid == request.auth.uid &&
                         request.resource.data.acknowledged == false &&
                         request.auth.uid in request.resource.data.memberUids &&
                         isCoupleMemberDoc(coupleId) &&
                         request.resource.data.memberUids == get(couplePath(coupleId)).data.memberUids;

        allow update: if isSignedIn() &&
                         isValidId(coupleId) &&
                         isValidId(checkinId) &&
                         isValidCareCheckIn(request.resource.data, coupleId) &&
                         request.resource.data.coupleId == resource.data.coupleId &&
                         request.resource.data.senderUid == resource.data.senderUid &&
                         request.resource.data.senderName == resource.data.senderName &&
                         request.resource.data.careType == resource.data.careType &&
                         request.resource.data.message == resource.data.message &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         (
                           (
                             request.auth.uid in resource.data.memberUids &&
                             request.auth.uid != resource.data.senderUid &&
                             request.resource.data.memberUids == resource.data.memberUids &&
                             request.resource.data.acknowledged == true &&
                             request.resource.data.acknowledgedByUid == request.auth.uid &&
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledged', 'acknowledgedByUid', 'updatedAt'])
                           ) ||
                           (
                             resource.data.senderUid == request.auth.uid &&
                             isCoupleMemberDoc(coupleId) &&
                             request.resource.data.memberUids == get(couplePath(coupleId)).data.memberUids &&
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
                           )
                         );

        allow delete: if isSignedIn() && isValidId(coupleId) && isValidId(checkinId) && request.auth.uid in resource.data.memberUids;
      }

      // --- 15. SHARED LOVE DOODLE CANVAS ---
      match /love_doodles/{doodleId} {
        allow get: if isSignedIn() && isValidId(coupleId) && isValidId(doodleId) && request.auth.uid in resource.data.memberUids;
        allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;

        allow create: if isSignedIn() &&
                         isValidId(coupleId) &&
