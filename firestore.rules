                         request.resource.data.keys().hasOnly(['coupleId', 'artistUid', 'artistName', 'memberUids', 'title', 'imageBase64', 'lovedByPartner', 'createdAt', 'updatedAt']) &&
                         isValidLoveDoodle(request.resource.data, coupleId) &&
                         request.resource.data.artistUid == request.auth.uid &&
                         request.resource.data.lovedByPartner == false &&
                         request.auth.uid in request.resource.data.memberUids &&
                         isCoupleMemberDoc(coupleId) &&
                         request.resource.data.memberUids == get(couplePath(coupleId)).data.memberUids;

        allow update: if isSignedIn() &&
                         isValidId(coupleId) &&
                         isValidId(doodleId) &&
                         isValidLoveDoodle(request.resource.data, coupleId) &&
                         request.resource.data.coupleId == resource.data.coupleId &&
                         request.resource.data.artistUid == resource.data.artistUid &&
                         request.resource.data.artistName == resource.data.artistName &&
                         request.resource.data.title == resource.data.title &&
                         request.resource.data.imageBase64 == resource.data.imageBase64 &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         (
                           (
                             request.auth.uid in resource.data.memberUids &&
                             request.auth.uid != resource.data.artistUid &&
                             request.resource.data.memberUids == resource.data.memberUids &&
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lovedByPartner', 'updatedAt'])
                           ) ||
                           (
                             resource.data.artistUid == request.auth.uid &&
                             isCoupleMemberDoc(coupleId) &&
                             request.resource.data.memberUids == get(couplePath(coupleId)).data.memberUids &&
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
                           )
                         );

        allow delete: if isSignedIn() && isValidId(coupleId) && isValidId(doodleId) && request.auth.uid in resource.data.memberUids;
      }

      // --- 16. COUPLE PROMISE & PINKY-SWEAR VAULT ---
      match /couple_promises/{promiseId} {
        allow get: if isSignedIn() && isValidId(coupleId) && isValidId(promiseId) && request.auth.uid in resource.data.memberUids;
        allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;

        allow create: if isSignedIn() &&
                         isValidId(coupleId) &&
                         isValidId(promiseId) &&
                         request.resource.data.keys().hasAll(['coupleId', 'creatorUid', 'creatorName', 'memberUids', 'title', 'category', 'signedByUids', 'createdAt', 'updatedAt']) &&
                         request.resource.data.keys().hasOnly(['coupleId', 'creatorUid', 'creatorName', 'memberUids', 'title', 'category', 'signedByUids', 'createdAt', 'updatedAt']) &&
                         isValidCouplePromise(request.resource.data, coupleId) &&
                         request.resource.data.creatorUid == request.auth.uid &&
                         request.resource.data.signedByUids.size() == 1 &&
                         request.resource.data.signedByUids[0] == request.auth.uid &&
                         request.auth.uid in request.resource.data.memberUids &&
                         isCoupleMemberDoc(coupleId) &&
                         request.resource.data.memberUids == get(couplePath(coupleId)).data.memberUids;

        allow update: if isSignedIn() &&
                         isValidId(coupleId) &&
                         isValidId(promiseId) &&
                         isValidCouplePromise(request.resource.data, coupleId) &&
                         request.resource.data.coupleId == resource.data.coupleId &&
                         request.resource.data.creatorUid == resource.data.creatorUid &&
                         request.resource.data.creatorName == resource.data.creatorName &&
                         request.resource.data.title == resource.data.title &&
                         request.resource.data.category == resource.data.category &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         (
                           (
                             request.auth.uid in resource.data.memberUids &&
                             request.resource.data.memberUids == resource.data.memberUids &&
                             request.auth.uid in request.resource.data.signedByUids &&
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signedByUids', 'updatedAt'])
                           ) ||
                           (
                             resource.data.creatorUid == request.auth.uid &&
                             isCoupleMemberDoc(coupleId) &&
                             request.resource.data.memberUids == get(couplePath(coupleId)).data.memberUids &&
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
                           )
                         );

        allow delete: if isSignedIn() && isValidId(coupleId) && isValidId(promiseId) && request.auth.uid in resource.data.memberUids;
