                         request.resource.data.coupleId == resource.data.coupleId &&
                         request.resource.data.authorUid == resource.data.authorUid &&
                         request.resource.data.authorName == resource.data.authorName &&
                         request.resource.data.kind == resource.data.kind &&
                         request.resource.data.text == resource.data.text &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         (
                           (
                             request.auth.uid in resource.data.memberUids &&
                             request.resource.data.memberUids == resource.data.memberUids &&
                             (!('grantedByUid' in request.resource.data) || request.resource.data.grantedByUid == null || request.resource.data.grantedByUid == request.auth.uid) &&
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['granted', 'grantedByUid', 'updatedAt'])
                           ) ||
                           (
                             resource.data.authorUid == request.auth.uid &&
                             isCoupleMemberDoc(coupleId) &&
                             request.resource.data.memberUids == get(couplePath(coupleId)).data.memberUids &&
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
                           )
                         );

        allow delete: if isSignedIn() && isValidId(coupleId) && isValidId(noteId) && request.auth.uid in resource.data.memberUids;
      }

      // --- 13. SHARED MUSIC & VIBE DEDICATIONS ---
      match /vibe_dedications/{vibeId} {
        allow get: if isSignedIn() && isValidId(coupleId) && isValidId(vibeId) && request.auth.uid in resource.data.memberUids;
        allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;

        allow create: if isSignedIn() &&
